#!/bin/bash
set -e

echo "==> Instalando pacotes do repositório oficial..."
sudo pacman -S --needed - < ~/.config/packages/pacman.txt

echo "==> Instalando pacotes do AUR..."
if command -v paru &>/dev/null; then
    paru -S --needed - < ~/.config/packages/aur.txt
elif command -v yay &>/dev/null; then
    yay -S --needed - < ~/.config/packages/aur.txt
else
    echo "AVISO: nenhum helper AUR encontrado (paru/yay). Instale manualmente os pacotes em ~/.config/packages/aur.txt"
fi

echo "==> Instalando pacotes do Homebrew..."
if command -v brew &>/dev/null; then
    brew bundle install --file ~/.config/packages/Brewfile
else
    echo "AVISO: brew não encontrado. Instale via https://brew.sh e rode 'brew bundle install --file ~/.config/packages/Brewfile'"
fi

echo "==> Instalando helper de power-saver do ThinkPad (DYTC lapmode)..."
# O EC do ThinkPad (DYTC lapmode) reverte platform_profile=low-power para
# balanced, então powerprofilesctl set power-saver não segura. Recarregar o
# thinkpad_acpi reseta esse estado. O atalho WIN+SHIFT+S chama o helper via
# sudo sem senha antes de aplicar o power-saver.
if [ -f ~/.config/omarchy/reload-thinkpad-acpi ]; then
    sudo install -m755 -o root -g root ~/.config/omarchy/reload-thinkpad-acpi /usr/local/bin/reload-thinkpad-acpi
    sudo install -m440 -o root -g root ~/.config/omarchy/reload-thinkpad-acpi.sudoers /etc/sudoers.d/reload-thinkpad-acpi
    sudo visudo -c -f /etc/sudoers.d/reload-thinkpad-acpi
fi

echo "==> Configurando TLP (substitui power-profiles-daemon)..."
# tlp/tlp-pd vêm do pacman.txt. tlp-pd reimplementa a API D-Bus PowerProfiles
# que a Waybar do Omarchy consome. Habilita os serviços e recria o symlink que o
# wrapper ~/.local/bin/powerprofilesctl espera em /usr/bin (o binário original
# some junto com power-profiles-daemon).
if command -v tlp &>/dev/null; then
    sudo systemctl disable --now power-profiles-daemon.service 2>/dev/null || true
    sudo systemctl enable tlp.service
    sudo systemctl enable --now tlp-pd.service
    sudo ln -sf /usr/bin/tlpctl /usr/bin/powerprofilesctl
    sudo tlp start
fi

echo "==> Pronto!"
