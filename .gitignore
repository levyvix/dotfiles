# Nested git repos (managed separately)
.config/nvim/.git
.config/nvim/.git/**
.config/zsh/.git
.config/zsh/.git/**

# User content directories - not configuration
Downloads/
Documents/
Videos/
Pictures/
Music/
Desktop/
Public/
Templates/
Projects/
Work/
Applications/

# Cache directories
.cache/
.cargo/

# Codex / Claude / agent state - keep only skills
.agents/*
!.agents/skills/
!.agents/skills/**
.claude/*
!.claude/agents/
!.claude/agents/**
!.claude/commands/
!.claude/commands/**
!.claude/rules/
!.claude/rules/**
!.claude/settings.json
!.claude/skills
.codex/*
!.codex/skills
!.cursor/skills
.agents/skills/.system

# Backup files
*.bak
*.bak.*
*.backup
init.backup
shell.backup
plugins.backup-lazy

# Secrets / private cache
.config/zsh/secrets

# jj repo-specific data
.config/jj/repos/

# Claude Code temporary and sensitive data
.claude/projects/
.claude/debug/
.claude/backups/
.claude/cache/
.claude/todos/
.claude/.credentials.json
.claude/statsig/

# App/browser state, caches, databases, cookies, logs and ephemeral runtime data
.config/Bitwarden/
.config/chatgpt/
.config/chromium/
.config/obsidian/
.config/pulse/
.config/libaccounts-glib/
.config/homebrew/
.config/uv/
.config/go/telemetry/
.config/zen/
.config/qBittorrent/lockfile
.config/qBittorrent/rss/
.config/fcitx/dbus/
.config/ibus/bus/
.config/fcitx5/conf/cached_layouts
.config/gtk-3.0/bookmarks
.config/dconf/
.config/qBittorrent/
.config/omarchy/current/
.config/omarchy.ttf
.config/systemd/user/*.wants/
.config/cliamp/*.log
.config/cliamp/*.pid
.config/golazo/*.json
.config/golazo/*.txt
.config/configstore/
.config/com.pake.aa2b7c1/

# Secrets and machine-local auth
.config/gh/hosts.yml
# Tokens de API e cookies de sessão (LEETCODE_SESSION, LEETCODE_CSRF, ...)
.config/zsh/envs

# Common transient files under otherwise useful config trees
*.log
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db
*.db-journal
*.pma
*.lock
*.pid
*.sock
*.tmp
