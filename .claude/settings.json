{
  "attribution": {},
  "effortLevel": "medium",
  "enabledPlugins": {
    "brag@brag": false,
    "caveman@caveman": false,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-code-plugins": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": false,
    "pydantic-ai@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "extraKnownMarketplaces": {
    "brag": {
      "source": {
        "repo": "latent-spaces/brag",
        "source": "github"
      }
    },
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/home/levi/.claude/hooks/rtk-rewrite.sh",
            "type": "command"
          },
          {
            "command": "/home/levi/.claude/hooks/sudo-passwordless-toggle.sh",
            "if": "Bash(sudo*)",
            "statusMessage": "Verificando sudo passwordless...",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/levi/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "language": "pt-br",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(uv:*)"
    ],
    "defaultMode": "auto"
  },
  "preferredNotifChannel": "auto",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "/home/levi/.local/bin/best-claude-hud",
    "padding": 0,
    "type": "command"
  },
  "theme": "dark"
}
