{
  "permissions": {
    "allow": [
      "Bash(uv run:*)"
    ],
    "defaultMode": "dontAsk"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/levi/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/levi/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "commit-commands@claude-code-plugins": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true
  },
  "language": "pt-br",
  "effortLevel": "low",
  "voiceEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "ENABLE_LSP_TOOL": "1",
  "mcpServers": {
    "entroly": {
      "command": "entroly",
      "args": [
        "serve"
      ]
    }
  },
  "model": "haiku"
}
