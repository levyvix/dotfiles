{
  "attribution": {},
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(uv:*)"
    ],
    "defaultMode": "dontAsk"
  },
  "model": "haiku",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/levi/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "/home/levi/.claude/hooks/sudo-passwordless-toggle.sh",
            "if": "Bash(sudo*)",
            "statusMessage": "Verificando sudo passwordless..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/levi/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-code-plugins": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "caveman@caveman": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    }
  },
  "language": "pt-br",
  "effortLevel": "medium",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true
}
