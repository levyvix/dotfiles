{
  "ENABLE_LSP_TOOL": "1",
  "effortLevel": "low",
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-code-plugins": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/home/levi/.claude/hooks/snip-rewrite.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "language": "pt-br",
  "mcpServers": {},
  "model": "haiku",
  "permissions": {
    "allow": [
      "Bash(uv run:*)"
    ],
    "defaultMode": "dontAsk"
  },
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "/home/levi/.claude/statusline.sh",
    "padding": 0,
    "type": "command"
  },
  "voiceEnabled": false
}
