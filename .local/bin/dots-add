#!/bin/bash
set -e

if [[ $# -lt 1 ]]; then
    echo "Usage: dots-add <path> [path...]"
    exit 1
fi

show_section() {
    printf "\n== %s ==\n" "$1"
}

repo_root="$(yadm rev-parse --show-toplevel)"

paths=()
for arg in "$@"; do
    if [[ $arg == ~* ]]; then
        arg="${arg/#\~/$HOME}"
    fi

    if [[ $arg != /* ]]; then
        arg="$(realpath -m "$PWD/$arg")"
    fi

    if [[ ! -e $arg ]]; then
        echo "Path not found: $arg" >&2
        exit 1
    fi

    rel="$(realpath --relative-to="$HOME" "$arg")"
    if [[ $rel == ..* ]]; then
        echo "Path must be inside $HOME: $arg" >&2
        exit 1
    fi

    paths+=("$rel")
done

show_section "Adding Paths"
printf "%s\n" "${paths[@]}"

(
    cd "$repo_root"
    yadm add -- "${paths[@]}"
)

show_section "Staged Files"
(
    cd "$repo_root"
    yadm diff --cached --name-status -- "${paths[@]}"
)
